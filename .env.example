# TMDB "API Read Access Token" (v4) or v3 API key — https://www.themoviedb.org/settings/api
# Leave empty to use the built-in demo catalog.
TMDB_API_KEY=

# Postgres connection string (Neon pooled URL in production).
# Leave empty locally to use an embedded database stored in .data/
DATABASE_URL=

# Random 32+ character string used to sign sessions:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Public URL of the site. Optional on Vercel (it is detected automatically);
# set it to your custom domain, e.g. https://tvlist.example.com
BETTER_AUTH_URL=http://localhost:3000

# Optional social sign-in (enabled automatically when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Required in production: protects /api/cron/* (Vercel Cron sends it automatically).
# Any long random string, e.g.  openssl rand -hex 32
CRON_SECRET=

# Optional: direct (non-pooled) Postgres URL used for migrations during Vercel builds.
# If unset, it is derived from DATABASE_URL by dropping Neon's "-pooler" host suffix.
DATABASE_URL_UNPOOLED=

# Optional: avatar/banner uploads (Vercel Blob). Without it users paste image URLs.
BLOB_READ_WRITE_TOKEN=
