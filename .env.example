# TMDB "API Read Access Token" (v4) or v3 API key — https://www.themoviedb.org/settings/api
# Leave empty to use the built-in demo catalog.
TMDB_API_KEY=

# Postgres connection string (Neon pooled URL in production).
# Leave empty locally to use an embedded database stored in .data/
DATABASE_URL=

# Random 32+ character string used to sign sessions:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Public URL of the site (http://localhost:3000 locally, https://your-domain in production)
BETTER_AUTH_URL=http://localhost:3000

# Optional social sign-in (enabled automatically when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: protects /api/cron/* (Vercel Cron sends it automatically)
CRON_SECRET=
